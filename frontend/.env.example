# Copy to .env.local and fill in. See CLAUDE.md for details.

# Supabase — project "Haffadh Home"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Custom JWT signing for /auth/*
JWT_SECRET=

# Same-origin API calls (leave empty)
NEXT_PUBLIC_API_BASE=

# Wall dashboard read-only token (Phase 3).
# Long random string, e.g. `openssl rand -hex 32`. The iPad pairs once via
# /dashboard?token=<value>; the token can only read /dashboard/summary.
DASHBOARD_TOKEN=
